# Copy to .env. `uv run --env-file .env ...` loads it (do not `source` it).

# Database. Empty means sqlite:///data/artemis.db for scripts.serve and in-memory SQLite for tests.
# Postgres 16: postgresql+psycopg://artemis:artemis@localhost:5432/artemis
DATABASE_URL=
# docker compose only
POSTGRES_PASSWORD=artemis

# Lane B: any OpenAI-compatible provider with tool calling. Defaults target Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
BATCH_CONCURRENCY=2
# 1: let the model rephrase narratives (a validator rejects any invented figure)
LLM_NARRATIVE=0
# Estimated cost shown in the metrics, paise per million tokens
LLM_PRICE_IN_PAISE_PER_MTOK=0
LLM_PRICE_OUT_PAISE_PER_MTOK=0
# fixtures | real
ARTEMIS_BACKEND=fixtures

# Lane C
# Ed25519 key for audit checkpoints, created if missing
SIGNING_KEY_PATH=data/signing_key.pem
# A recorded batch for replay mode (runs/latest-demo.json is picked up by default)
REPLAY_FILE=
# 0 disables POST /reset (use on the hosted copy)
DEMO_MODE=1
# When set, write routes need "Authorization: Bearer <token>"
ARTEMIS_API_TOKEN=
# 0: do not reload the environment when the API starts (the compose setup seeds once, in scripts/seed.py)
ARTEMIS_PREPARE=1
FORCE_HTTPS=0
RUNS_DIR=
EXPORTS_DIR=
