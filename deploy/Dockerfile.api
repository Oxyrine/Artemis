# API image: Python 3.11 (the spec's pin), deps from uv.lock, then migrate + seed + serve (deploy/api-entrypoint.sh).
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv==0.9.2
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY alembic.ini ./
COPY migrations ./migrations
COPY artemis ./artemis
COPY data ./data
COPY contracts ./contracts
COPY scripts ./scripts
COPY deploy/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH=/app SIGNING_KEY_PATH=/keys/signing_key.pem ARTEMIS_PREPARE=0
EXPOSE 8000
ENTRYPOINT ["sh", "/usr/local/bin/api-entrypoint.sh"]
