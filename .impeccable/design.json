    },
    {
      "name": "Open variance bridge",
      "kind": "custom",
      "refersTo": "balance-panel",
      "description": "Preview proportions are illustrative; application widths are calculated from actual explained and held paise.",
      "html": "<section class=\"ds-balance\"><h2>Reconciliation overview</h2><div class=\"ds-bridge-labels\"><span>Explained</span><span>Held for review</span></div><div class=\"ds-bridge\" role=\"img\" aria-label=\"Illustrative explained and held proportions\"><span></span><span></span></div></section>",
      "css": ".ds-balance{padding:0;border-radius:0;background:transparent;color:var(--foreground);font-family:Geist Variable,sans-serif;} .ds-balance h2{font-family:Instrument Serif,Georgia,serif;font-size:26px;line-height:1;font-weight:400;margin:0 0 22px;} .ds-bridge-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--muted-foreground);margin-bottom:8px;} .ds-bridge{display:flex;gap:4px;height:10px;} .ds-bridge span{border-radius:2px;transition:width 300ms cubic-bezier(.16,1,.3,1);} .ds-bridge span:first-child{width:65%;background:var(--status-verified);} .ds-bridge span:last-child{width:35%;background:var(--primary);} @media(prefers-reduced-motion:reduce){.ds-bridge span{transition-duration:.01ms;}}"
    },
    {
      "name": "Readable evidence relationships",
      "kind": "custom",
      "description": "Graph as text is open by default, resolves graph-node labels, and moves above the visual graph at 760px and below.",
      "html": "<div class=\"ds-evidence\"><div class=\"ds-graph\" role=\"img\" aria-label=\"Evidence graph preview\">Receipt → Invoice</div><details class=\"ds-graph-text\" open><summary>Graph as text</summary><ul><li>Receipt Demo receipt → Invoice Demo invoice: supports</li></ul></details></div>",
      "css": ".ds-evidence{font-family:Geist Variable,sans-serif;color:var(--foreground);font-size:14px;} .ds-graph{padding:24px;border:1px solid var(--border);border-radius:8px;background:var(--card);} .ds-graph-text{margin-top:8px;} .ds-graph-text summary{cursor:pointer;color:var(--muted-foreground);} .ds-graph-text summary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;} .ds-graph-text ul{padding-left:20px;margin-top:4px;} @media(max-width:760px){.ds-evidence{display:flex;flex-direction:column;}.ds-graph-text{order:-1;margin:0 0 18px;}.ds-graph-text li{margin-block:8px;overflow-wrap:anywhere;line-height:1.6;}}"
    }
  ],
  "narrative": {
    "northStar": "The Annual Report",
    "overview": "Artemis uses the hierarchy of an annual report: deep ink navigation, a cool paper canvas, cobalt actions, Instrument Serif headings and precise Geist figures. Open document sections, whitespace and thin rules carry the composition.\n\nReceipts, variance closure and evidence share the page without repeated card containers. The variance bridge uses actual explained and held paise; meaningful status and provenance appear as plain text. Enclosed surfaces are reserved for controls and interactions that require containment.",
    "keyCharacteristics": [
      "Open document sections and column separators.",
      "Deep navy navigation, cobalt actions and cool paper.",
      "Self-hosted Instrument Serif titles with Geist records and tabular figures.",
      "Actual variance proportions and plain-language review evidence."
    ],
    "rules": [
      {
        "name": "The Open Document Rule",
        "body": "Use whitespace, top rules and column separators for working sections. Do not wrap each region in a rounded card.",
        "section": "elevation"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Instrument Serif for editorial headings and Geist for records, controls and financial figures.",
        "section": "typography"
      },
      {
        "name": "The Data Is Material Rule",
        "body": "Draw the variance bridge from actual explained and held paise. Keep global totals independent of queue filters.",
        "section": "layout"
      },
      {
        "name": "The Status Meaning Rule",
        "body": "Verified is green, Probable amber, Insufficient grey, Conflicting red and Auto-closed blue. Keep written states; color supplements text.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use open document sections, whitespace and thin rules as the default.",
      "Do retain containment for the evidence graph viewport, floating guide, form fields and confirmation dialogs.",
      "Do keep meaningful queue status, review state, mode and narrative provenance as plain text.",
      "Do retain synthetic-data disclosure in the footer and explicitly label synthetic benchmark results.",
      "Do keep global financial totals independent of queue filters.",
      "Do preserve integer paise and format amounts only through web/src/lib/format.ts.",
      "Do preserve policy limits, named reviewer decisions, required comments, reset confirmation and status meanings.",
      "Do support keyboard focus, reduced motion and readable tablet/mobile receipt rows."
    ],
    "donts": [
      "Don't repeat rounded card containers across dashboard, welcome, comparison, evidence and review sections.",
      "Don't add case-header Verified, Pending approval or Demo agent badges.",
      "Don't restore the Synthetic environment topbar label or Receivables workspace / INR sidebar strip.",
      "Don't invent figures or turn Probable amber into a red error.",
      "Don't add remote fonts or shipping raster imagery.",
      "Don't present configured tax rules as advice or synthetic accuracy as production accuracy."
    ]
  }
}
