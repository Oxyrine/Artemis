  "components": [
    {
      "name": "Run batch",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "primary compact action.",
      "html": "<button class=\"ds-button-primary\">Run batch</button>",
      "css": ".ds-button-primary{font-family:'Geist Variable',sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;height:37px;padding:0 10px;border:1px solid transparent;border-radius:6px;font-weight:500;background:var(--primary);color:var(--primary-foreground);cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;} .ds-button-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent);} .ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;} .ds-button-primary:active{transform:translateY(1px);}"
    },
    {
      "name": "Reset demo",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "outline compact action.",
      "html": "<button class=\"ds-button-outline\">Reset demo</button>",
      "css": ".ds-button-outline{font-family:'Geist Variable',sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;height:37px;padding:0 10px;border:1px solid var(--border);border-radius:6px;font-weight:500;background:var(--background);color:var(--foreground);cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;} .ds-button-outline:hover{background:var(--muted);} .ds-button-outline:focus-visible{outline:2px solid var(--ring);outline-offset:3px;} .ds-button-outline:active{transform:translateY(1px);}"
    },
    {
      "name": "View audit",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "ghost compact action.",
      "html": "<button class=\"ds-button-ghost\">View audit</button>",
      "css": ".ds-button-ghost{font-family:'Geist Variable',sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;height:37px;padding:0 10px;border:1px solid transparent;border-radius:6px;font-weight:500;background:transparent;color:var(--foreground);cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;} .ds-button-ghost:hover{background:var(--muted);} .ds-button-ghost:focus-visible{outline:2px solid var(--ring);outline-offset:3px;} .ds-button-ghost:active{transform:translateY(1px);}"
    },
    {
      "name": "Queue search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Compact receipt/customer search.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\"/></svg><input aria-label=\"Search receipts\" placeholder=\"Search receipts or customers\"/></label>",
      "css": ".ds-search{display:block;position:relative;max-width:340px;color:var(--muted-foreground);} .ds-search svg{position:absolute;left:10px;top:9px;width:16px;height:16px;} .ds-search input{font-family:'Geist Variable',sans-serif;font-size:13px;box-sizing:border-box;width:100%;height:36px;padding:4px 10px 4px 33px;font-size:12px;background:var(--background);color:var(--foreground);border:1px solid var(--input);border-radius:6px;} .ds-search input:focus-visible{outline:2px solid var(--ring);outline-offset:3px;border-color:var(--ring);}"
    },
    {
      "name": "Selected destination",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Active operational destination.",
      "html": "<a class=\"ds-nav\" href=\"#reconciliation\" aria-current=\"page\">Reconciliation <span aria-hidden=\"true\">→</span></a>",
      "css": ".ds-nav{font-family:'Geist Variable',sans-serif;font-size:13px;display:flex;align-items:center;gap:10px;padding:13px 12px;background:var(--sidebar-active);color:var(--sidebar-ink);border-radius:7px;text-decoration:none;font-weight:550;} .ds-nav span{margin-left:auto;} .ds-nav:hover{background:var(--sidebar-active);} .ds-nav:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}"
    },
    {
      "name": "Verified outcome",
      "kind": "chip",
      "refersTo": "chip-verified",
      "description": "Explicit semantic label and redundant dot.",
      "html": "<span class=\"ds-pill\">Verified</span>",
      "css": ".ds-pill{font-family:'Geist Variable',sans-serif;font-size:13px;display:inline-flex;align-items:center;gap:5px;border:1px solid transparent;padding:1px 7px;border-radius:9999px;font-size:12px;font-weight:500;line-height:18px;background:var(--status-verified-soft);color:var(--status-verified-fg);white-space:nowrap;} .ds-pill::before{content:\"\";width:5px;height:5px;border-radius:50%;background:currentColor;}"
    },
    {
      "name": "Work section",
      "kind": "card",
      "refersTo": "work-section",
      "description": "Flat surface for records and supporting evidence.",
      "html": "<section class=\"ds-section\"><h2>Receipt queue</h2><p>Inspect a receipt and its supporting evidence.</p></section>",
      "css": ".ds-section{font-family:'Geist Variable',sans-serif;font-size:13px;padding:24px;background:var(--card);color:var(--card-foreground);border:0;border-radius:12px;} .ds-section h2{font-size:17px;font-weight:550;letter-spacing:-.025em;margin:0 0 18px;} .ds-section p{font-size:13px;color:var(--muted-foreground);margin:0;}"
    },
    {
      "name": "Variance bridge",
      "kind": "custom",
      "refersTo": "balance-panel",
      "description": "Preview proportions are illustrative; application widths are calculated from actual explained and held paise.",
      "html": "<section class=\"ds-balance\"><h2>Reconciliation overview</h2><div class=\"ds-bridge-labels\"><span>Explained</span><span>Held for review</span></div><div class=\"ds-bridge\" role=\"img\" aria-label=\"Illustrative explained and held proportions\"><span></span><span></span></div></section>",
      "css": ".ds-balance{padding:25px 28px 19px;border-radius:12px;background:var(--balance-ground);color:var(--balance-ink);font-family:Geist Variable,sans-serif;} .ds-balance h2{font-family:Instrument Serif,Georgia,serif;font-size:26px;line-height:1;font-weight:400;margin:0 0 22px;} .ds-bridge-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--balance-muted);margin-bottom:8px;} .ds-bridge{display:flex;gap:4px;height:10px;} .ds-bridge span{border-radius:2px;transition:width 300ms cubic-bezier(.16,1,.3,1);} .ds-bridge span:first-child{width:65%;background:var(--balance-explained);} .ds-bridge span:last-child{width:35%;background:var(--balance-held);} @media(prefers-reduced-motion:reduce){.ds-bridge span{transition-duration:.01ms;}}"
    },
    {
      "name": "Readable evidence relationships",
      "kind": "custom",
      "description": "Graph as text is open by default, resolves graph-node labels, and moves above the visual graph at 760px and below.",
      "html": "<div class=\"ds-evidence\"><div class=\"ds-graph\" role=\"img\" aria-label=\"Evidence graph preview\">Receipt → Invoice</div><details class=\"ds-graph-text\" open><summary>Graph as text</summary><ul><li>Receipt Demo receipt → Invoice Demo invoice: supports</li></ul></details></div>",
      "css": ".ds-evidence{font-family:Geist Variable,sans-serif;color:var(--foreground);font-size:14px;} .ds-graph{padding:24px;border:1px solid var(--border);border-radius:8px;background:var(--card);} .ds-graph-text{margin-top:8px;} .ds-graph-text summary{cursor:pointer;color:var(--muted-foreground);} .ds-graph-text summary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;} .ds-graph-text ul{padding-left:20px;margin-top:4px;} @media(max-width:760px){.ds-evidence{display:flex;flex-direction:column;}.ds-graph-text{order:-1;margin:0 0 18px;}.ds-graph-text li{margin-block:8px;overflow-wrap:anywhere;line-height:1.6;}}"
    }
  ],
  "narrative": {
    "northStar": "The Annual Report",
    "overview": "Artemis takes its hierarchy from an annual report: deep ink navigation frames a cool paper canvas, cobalt marks actions, and expressive serif titles distinguish interpretation from the figures beneath them. The composition is asymmetric and deliberate, with white working surfaces and quiet rules.\n\nInstrument Serif supplies the editorial voice; Geist keeps records and numbers precise. A navy reconciliation panel turns actual explained and held paise into a split variance bridge. Data is the visual material, and semantic statuses retain their established meanings.",
    "keyCharacteristics": [
      "Deep navy navigation and cobalt actions.",
      "Self-hosted Instrument Serif headings with Geist body and figures.",
      "Live variance bridge beside an asymmetric white outcome index.",
      "Cool paper, generous surface corners and quiet table rules."
    ],
    "rules": [
      {
        "name": "The Status Meaning Rule",
        "body": "Verified is green, Probable amber, Insufficient grey, Conflicting red and Auto-closed blue. Preserve explicit status text; color supplements the label.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Instrument Serif for editorial headings and the sidebar statement; keep records, controls and financial figures in Geist.",
        "section": "typography"
      },
      {
        "name": "The Data Is Material Rule",
        "body": "Draw the variance bridge from actual explained and held paise. Global overview totals remain stable when the queue is filtered.",
        "section": "layout"
      },
      {
        "name": "The Flat Record Rule",
        "body": "Separate records with surface tone and quiet rules; reserve shadows for temporary overlapping controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use shared semantic colors from web/src/design/tokens.css and final visual rules from web/src/design/editorial.css.",
      "Do keep global financial totals independent of queue filters.",
      "Do align financial figures and preserve explicit status labels.",
      "Do preserve integer paise and format amounts only through web/src/lib/format.ts.",
      "Do explicitly label synthetic data and synthetic benchmark results.",
      "Do preserve policy limits, reviewer identity, required comments, reset confirmation and status meanings.",
      "Do support keyboard focus, reduced motion and mobile receipt inspection."
    ],
    "donts": [
      "Don't replace Instrument Serif headings with generic sans-serif titles.",
      "Don't reintroduce the superseded achromatic olive identity.",
      "Don't invent performance figures or substitute a decorative split for actual paise data.",
      "Don't make Probable amber read as a red error.",
      "Don't add remote font dependencies or shipping raster imagery.",
      "Don't imply configured tax rules are tax advice or synthetic accuracy is production accuracy."
    ]
  }
}
