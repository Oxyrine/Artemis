  "narrative": {
    "northStar": "The Achromatic Ledger",
    "overview": "The Achromatic Ledger makes dense financial records composed and inspectable. Warm stone grounds, near-black ink and white work surfaces give receipts and evidence a clear hierarchy. Muted olive marks the product identity; outcome colors retain their precise semantic jobs.\n\nThis Operate-mode workspace is compact, quiet and direct. Self-hosted Geist, tabular figures and aligned rules carry the interface. Its signature is variance closure beside policy-controlled review, supported by an evidence graph and a separately verifiable audit history.",
    "keyCharacteristics": [
      "Warm stone surfaces and near-black ink.",
      "Compact operational typography with tabular financial figures.",
      "Flat bordered containers and restrained state transitions.",
      "Status labels, evidence tiers and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Status Meaning Rule",
        "body": "Verified is green, Probable amber, Insufficient grey, Conflicting red and Auto-closed blue. Preserve explicit status text; color supplements the label.",
        "section": "colors"
      },
      {
        "name": "The Financial Figure Rule",
        "body": "Use tabular figures for money and sequence values. Keep identifier monospace separate from amount presentation.",
        "section": "typography"
      },
      {
        "name": "The Flat Record Rule",
        "body": "Use borders and tonal separation for records; reserve lift for overlapping controls and navigation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared semantic tokens in web/src/design/tokens.css.",
      "Do align financial figures and keep status text beside its color.",
      "Do preserve integer paise and format amounts only through web/src/lib/format.ts.",
      "Do explicitly label synthetic demo data and synthetic benchmark results.",
      "Do preserve approval limits, named reviewer decisions, required comments, reset confirmation and status meanings.",
      "Do support keyboard focus, reduced motion and mobile inspection."
    ],
    "donts": [
      "Don't substitute a brand accent for a semantic outcome color.",
      "Don't make Probable amber read as a red or salmon error.",
      "Don't add raster decoration to this asset-free operational world.",
      "Don't imply configured tax rules are tax advice or synthetic accuracy is production accuracy."
    ]
  }
}
