      "css": ".ds-button-primary{font-family:'Geist Variable',sans-serif;font-size:13px;display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 10px;border:1px solid transparent;border-radius:8px;font-weight:500;background:var(--primary);color:var(--primary-foreground);cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;} .ds-button-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent);} .ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;} .ds-button-primary:active{transform:translateY(1px);}"
